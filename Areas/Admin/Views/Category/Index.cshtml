

@model IEnumerable<Category>

<div class="content">
    <div class="container-fluid px-4">
        <!-- Header Section with Custom Style -->
        <div class="row align-items-center py-4">
            <div class="col-sm-6">
                <h3 class="fw-bold text-dark mb-0">Categories Management</h3>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <a href="/Admin/Category/Create" class="btn btn-primary px-4 py-2 shadow-sm">
                    <i class="fas fa-plus me-1"></i> Add New Category
                </a>
            </div>
        </div>

        <!-- Table Card Section -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-borderless table-striped align-middle mb-0">
                                <thead class="table-light text-uppercase fs-6">
                                    <tr>
                                        <!-- تم تصغير حجم خط الهيدر وضبط المسافات ليكون منسق ولا ينزل سطر جديد -->
                                        <th scope="col" class="py-3" style="font-size: 0.85rem; font-weight: 700;">#ID</th>
                                        <th scope="col" class="py-3" style="font-size: 0.85rem; font-weight: 700;">Category Name</th>
                                        <th scope="col" class="py-3" style="font-size: 0.85rem; font-weight: 700;">Current Status</th>
                                        <th scope="col" class="py-3 text-center" style="font-size: 0.85rem; font-weight: 700;">Manage Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model)
                                    {
                                        <tr>
                                            <th scope="row" class="fw-semibold text-secondary">@item.Id</th>
                                            <td class="fw-bold text-dark">@item.Name</td>
                                            <td>
                                                @if (item.Status)
                                                {
                                                    <span class="badge bg-opacity-10 text-success bg-success px-3 py-2 rounded-pill">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-opacity-10 text-danger bg-danger px-3 py-2 rounded-pill">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <a href="/Admin/Category/Update/@item.Id" class="btn btn-sm btn-outline-warning px-3 me-1">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="/Admin/Category/Delete/@item.Id" class="btn btn-sm btn-outline-danger px-3 btn-delete">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>